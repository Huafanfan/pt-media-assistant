# Server deployment template. Copy to /srv/app/pt-media-assistant/.env.server,
# keep it untracked, and chmod 600. This file contains no credential values.

# Source is staged separately from deployment metadata and secrets on the server.
# For repo-local Compose validation, temporarily override this with `.`.
PT_MEDIA_BUILD_CONTEXT=./source

# App listener and browser origin. The app uses host networking and binds only
# this server address; there is intentionally no Compose ports mapping.
PT_MEDIA_HOST=192.168.1.2
PT_MEDIA_PORT=4178
PT_MEDIA_ORIGIN=http://192.168.1.2:4178
PT_MEDIA_TRUST_LAN=1
PT_MEDIA_ALLOW_GRAB=0

# The server's existing native qBittorrent service remains outside Compose.
QBITTORRENT_URL=http://localhost:8080

# Prowlarr data is migrated into this server directory. Keep its config.xml
# BindAddress at 127.0.0.1 before starting the host-networked container.
PROWLARR_IMAGE=lscr.io/linuxserver/prowlarr:version-2.5.2.5491
PROWLARR_DATA_DIR=/srv/data/pt-media-assistant/prowlarr
PROWLARR_PUID=1000
PROWLARR_PGID=1000
PROWLARR_TZ=Asia/Shanghai

# The value is a path to a mode-0600 secret file, never the API key itself.
PROWLARR_API_KEY_FILE=/srv/app/pt-media-assistant/secrets/prowlarr_api_key

# Logical NAS path and the single marker file bind-mounted into the app.
# The NAS directory itself is never mounted into a container.
PT_MEDIA_NAS_PATH=/mnt/nas/pt
PT_MEDIA_NAS_CHECK_MODE=sentinel
PT_MEDIA_NAS_SENTINEL=.pt-media-assistant-mounted
PT_MEDIA_NAS_SENTINEL_PATH=/run/pt-media-nas-sentinel
# Linux server mode intentionally has no PT_MEDIA_NAS_STATUS_PATH.

# Optional compose.ai.yaml overlay; provision this secret separately before enabling.
# DS_BASE_URL=https://api.deepseek.com
# DS_AUTH_TOKEN_FILE=/srv/app/pt-media-assistant/secrets/deepseek_api_key
# PT_MEDIA_AI_MODEL=deepseek-flash
