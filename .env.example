# Network listener. Keep the service on a trusted home LAN only.
PT_MEDIA_HOST=0.0.0.0
PT_MEDIA_PORT=4178
PT_MEDIA_TRUST_LAN=1

# Local services.
PROWLARR_URL=http://127.0.0.1:9696
QBITTORRENT_URL=http://localhost:8080
PT_MEDIA_NAS_PATH=/Volumes/YourNAS/pt

# Optional overrides. The API key is auto-discovered from the local Prowlarr
# config on macOS when omitted. Never commit a populated .env file.
# PROWLARR_API_KEY=
# PROWLARR_API_KEY_FILE=
# PROWLARR_PROXY_TOKEN_FILE=
# When PT_MEDIA_TRUST_LAN=0, a six-digit pairing code is generated at startup.
# PT_MEDIA_PAIRING_CODE=

# Destructive boundary. Keep disabled for search/preview-only operation. Set to
# 1 only when explicit “加入下载” actions should be sent through Prowlarr.
PT_MEDIA_ALLOW_GRAB=0

# Container-only NAS safety gate. Native macOS runs should keep smbfs.
PT_MEDIA_NAS_CHECK_MODE=smbfs
PT_MEDIA_NAS_SENTINEL=.pt-media-assistant-mounted
# PT_MEDIA_NAS_SENTINEL_PATH=/run/pt-media-nas-sentinel
# PT_MEDIA_NAS_STATUS_PATH=/run/pt-media-nas-status

# Optional AI recommendations. Only server-side code reads these settings.
PT_MEDIA_AI_ENABLED=0
PT_MEDIA_AI_MODEL=gpt-5.6-luna
PT_MEDIA_AI_WEB_ENABLED=0
# Preferred gateway pair. Set both; never put keys in VITE_ variables.
# IVAN_ONLINE_API_URL=https://your-gateway.example/v1/chat/completions
# IVAN_ONLINE_API_KEY=
# IVAN_ONLINE_API_KEY_FILE=/absolute/path/to/model_api_key
# Optional public web search for the redesigned AI flow. Server-side only.
# TAVILY_API_KEY=
# TAVILY_API_KEY_FILE=/absolute/path/to/tavily_api_key
# TRANS_STATION_BASE_URL=https://your-model-provider.example/v1
# TRANS_STATION_API_KEY_FILE=/absolute/path/to/model-api-key
# Native development may use TRANS_STATION_API_KEY in the process environment.
